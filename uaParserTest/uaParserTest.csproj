<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\uaParserLibrary\uaParserLibrary.csproj" />
    <ProjectReference Include="..\uaParserMiddleware\uaParserMiddleware.csproj" />
    <ProjectReference Include="..\uaParserDemoComponents\uaParserDemoComponents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Answer key produced by tools/RuleGenerator -->
    <None Update="TestData\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- ua-parser-js's own test data, read from the generator's corpus, and the deliberate differences -->
    <None Include="..\tools\RuleGenerator\corpus\upstream-test-differences.json"
          Link="TestData\upstream-test-differences.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tools\RuleGenerator\corpus\ua-parser-js-1.0.41\*-test.json"
          Link="TestData\ua-parser-js\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
