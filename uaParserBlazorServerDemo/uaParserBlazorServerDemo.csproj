<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- uaParser.Net on the server: the request's ClientInfo, an interactive playground (Blazor Server),
       a log analyzer and a JSON API. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\uaParserMiddleware\uaParserMiddleware.csproj" />
    <ProjectReference Include="..\uaParserDemoComponents\uaParserDemoComponents.csproj" />
  </ItemGroup>

</Project>
