<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- uaParser.Net running in the browser: nothing is sent to a server. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <!-- dotnet run -c Release at full speed: without this, the build output (unlike publish) keeps
       .NET's debugging support on, which makes the WebAssembly code many times slower. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <WasmDebugLevel>0</WasmDebugLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\uaParserDemoComponents\uaParserDemoComponents.csproj" />
  </ItemGroup>

</Project>
