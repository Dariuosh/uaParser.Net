@page "/speed"

<PageTitle>Speed test · uaParser.Net</PageTitle>

<div class="page-head">
    <p class="eyebrow"><Icon Name="bolt" Size="16" /> Speed test</p>
    <h1>How fast is it in your browser?</h1>
