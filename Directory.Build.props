<Project>

  <!-- Shared by every project. Only uaParserLibrary and uaParserMiddleware are packaged. -->
  <PropertyGroup>
    <Version>2.0.0</Version>
    <Authors>Dariuosh</Authors>
    <Copyright>Copyright (c) 2021-2026 Dariuosh. Rules ported from ua-parser-js, copyright (c) 2012-2025 Faisal Salman.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Dariuosh/uaParser.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Dariuosh/uaParser.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>user-agent;useragent;ua-parser;parser;browser;device;os;detection;aspnetcore;blazor</PackageTags>
    <PackageReleaseNotes>https://github.com/Dariuosh/uaParser.Net/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <IsPackable>false</IsPackable>

    <!-- Source Link and reproducible builds -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
