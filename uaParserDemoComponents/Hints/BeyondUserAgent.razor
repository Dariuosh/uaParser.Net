@* What the browser knows beyond its User-Agent string: Client Hints, the GPU, touch support.
   Needs an interactive render mode: it asks the browser through JavaScript. *@
@inject DemoJs Js

@if (!_loaded)
{
    <div class="card"><p class="muted">Asking your browser…</p></div>
}
else
{
    @if (_iPadLike)
    {
        <div class="card callout">
            <Icon Name="tablet" Size="22" />
            <div>
                <h3>Is this an iPad?</h3>
                <p>
                    The user agent says <strong>@Words.OS(Info.OS)</strong>, but this screen supports
                    @_touchPoints touch points. Since iPadOS 13, Safari on an iPad sends the same user agent as a
                    Mac, so the user agent alone cannot tell them apart; a touch screen is a strong hint.
                </p>
            </div>
        </div>
    }

    <section class="card">
        <h2><Icon Name="fingerprint" Size="22" /> User-Agent Client Hints</h2>

        @if (_hints is null)
        {
            <p>
                Your browser does not support User-Agent Client Hints (Firefox and Safari do not), so its
                User-Agent string is all it tells websites, and uaParser.Net reads all of it.
            </p>
        }
        else
        {
            <p class="muted">
                Chromium-based browsers now send a reduced, “frozen” User-Agent string: some values in it are
                fixed, whatever the real ones are. The real values come as Client Hints, and uaParser.Net reads
                them too: <code>UAParser.GetClientInfo(userAgent, hints)</code>.
            </p>
            <div class="table-wrap">
                <table class="compare-table">
                    <thead>
                        <tr><th scope="col"></th><th scope="col">User-Agent string only</th><th scope="col">With Client Hints</th><th scope="col"></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Rows())
                        {
                            <tr>
                                <th scope="row">@row.Label</th>
                                <td><Value Text="@row.FromUserAgent" /></td>
                                <td><Value Text="@row.WithHints" /></td>
                                <td>
                                    @if (row.FromUserAgent != row.WithHints)
                                    {
                                        <span class="verdict v-more">more precise</span>
                                    }
                                    else if (row.FromUserAgent is not null)
                                    {
                                        <span class="verdict v-same">same</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="muted small">What your browser sent:</p>
            <code class="block">@_hints.ToString()</code>
            <p class="muted small">
                Without being asked, browsers only send the brands, “mobile” and the platform. A server asks for
                the rest with an <code>Accept-CH</code> header (<code>UAParserOptions.RequestClientHints</code>
                in ASP.NET Core); in the browser, <code>navigator.userAgentData.getHighEntropyValues</code> gives
                them, as on this page.
            </p>
        }
    </section>

    <section class="card">
        <h2><Icon Name="gpu" Size="22" /> Graphics card</h2>
        @if (_renderer is null)
        {
            <p>WebGL is not available, so there is no renderer string to read.</p>
        }
        else
        {
            <p class="muted">The WebGL renderer string, read with <code>UAParser.GetGPU</code>:</p>
            <code class="block">@_renderer</code>
            <dl class="kv">
                <dt>Vendor</dt><dd><Value Text="@_gpu?.Vendor" /></dd>
                <dt>Model</dt><dd><Value Text="@_gpu?.Model" /></dd>
            </dl>
            @if (_gpu is { Vendor: null, Model: null })
            {
                <p class="hint">
                    <Icon Name="info" Size="16" /> Not recognised. The GPU rules come from 2021 (ua-parser-js 1.x) and
                    predate the “ANGLE (vendor, model, …)” strings browsers send today.
                </p>
            }
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public ClientInfo Info { get; set; } = default!;

    private bool _loaded;
    private ClientHints? _hints;
    private ClientInfo? _withHints;
    private ClientInfo? _withoutHints;
    private string? _renderer;
    private GPU? _gpu;
    private int _touchPoints;
    private bool _iPadLike;

    private sealed record Row(string Label, string? FromUserAgent, string? WithHints);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _hints = (await Js.ClientHintsAsync())?.ToClientHints();
        _withoutHints = UAParser.GetClientInfo(Info.UserAgent);
        _withHints = _hints is null ? null : UAParser.GetClientInfo(Info.UserAgent, _hints);
        _renderer = await Js.WebGLRendererAsync();
        _gpu = _renderer is null ? null : UAParser.GetGPU(_renderer);
        _touchPoints = await Js.MaxTouchPointsAsync();
        _iPadLike = Info.OS.Name == "Mac OS" && _touchPoints > 1 && _hints is null;
        _loaded = true;
        StateHasChanged();
    }

    private IEnumerable<Row> Rows()
    {
        if (_withoutHints is not { } ua || _withHints is not { } hints)
            yield break;

        yield return new Row("Browser", Words.Join(ua.Browser.Name, ua.Browser.Version), Words.Join(hints.Browser.Name, hints.Browser.Version));
        yield return new Row("Engine", Words.Engine(ua.Engine), Words.Engine(hints.Engine));
        yield return new Row("Operating system", Words.OS(ua.OS), Words.OS(hints.OS));
        yield return new Row("Device", Device(ua.Device), Device(hints.Device));
        yield return new Row("CPU", ua.CPU.Architecture, hints.CPU.Architecture);
    }

    private static string? Device(Device device) =>
        Words.Join(Words.DeviceName(device), Words.DeviceKind(device.Type) is { } kind ? $"({kind})" : null);
}
