@* What the browser knows beyond its User-Agent string: Client Hints, the GPU, touch support.
   Needs an interactive render mode: it asks the browser through JavaScript. *@
@inject DemoJs Js

@if (!_loaded)
{
    <div class="card"><p class="muted">Asking your browser…</p></div>
}
else
{
    @if (_iPadLike)
    {
        <div class="card callout">
            <Icon Name="tablet" Size="22" />
            <div>
                <h3>Is this an iPad?</h3>
                <p>
                    The user agent says <strong>@Words.OS(Info.OS)</strong>, but this screen supports
                    @_touchPoints touch points. Since iPadOS 13, Safari on an iPad sends the same user agent as a
                    Mac, so the user agent alone cannot tell them apart; a touch screen is a strong hint.
                </p>
            </div>
        </div>
    }

    <section class="card">
        <h2><Icon Name="fingerprint" Size="22" /> User-Agent Client Hints</h2>

        @if (_hints is null)
        {
            <p>
                Your browser does not support User-Agent Client Hints (Firefox and Safari do not), so its
                User-Agent string is all it tells websites, and uaParser.Net reads all of it.
            </p>
        }
        else
        {
            <p class="muted">
                Chromium-based browsers now send a reduced, “frozen” User-Agent string: some values in it are
                fixed, whatever the real ones are. The real values are only available through Client Hints.
                Here is what each says.
            </p>
            <div class="table-wrap">
                <table class="compare-table">
                    <thead>
                        <tr><th scope="col"></th><th scope="col">User-Agent string (uaParser.Net)</th><th scope="col">Client Hints</th><th scope="col"></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Rows(_hints))
                        {
                            <tr>
                                <th scope="row">@row.Label</th>
                                <td><Value Text="@row.FromUserAgent" /></td>
                                <td><Value Text="@row.FromHints" Empty="not sent" /></td>
                                <td>
                                    @if (row.Verdict is { } verdict)
                                    {
                                        <span class="verdict v-@verdict.Kind">@verdict.Text</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="muted small">
                uaParser.Net 2.0 reads the User-Agent string only, like ua-parser-js 1.x. Servers can ask for Client
                Hints with the <code>Accept-CH</code> header; the Blazor Server demo shows them.
            </p>
        }
    </section>

    <section class="card">
        <h2><Icon Name="gpu" Size="22" /> Graphics card</h2>
        @if (_renderer is null)
        {
            <p>WebGL is not available, so there is no renderer string to read.</p>
        }
        else
        {
            <p class="muted">The WebGL renderer string, read with <code>UAParser.GetGPU</code>:</p>
            <code class="block">@_renderer</code>
            <dl class="kv">
                <dt>Vendor</dt><dd><Value Text="@_gpu?.Vendor" /></dd>
                <dt>Model</dt><dd><Value Text="@_gpu?.Model" /></dd>
            </dl>
            @if (_gpu is { Vendor: null, Model: null })
            {
                <p class="hint">
                    <Icon Name="info" Size="16" /> Not recognised. The GPU rules come from 2021 (ua-parser-js 1.x) and
                    predate the “ANGLE (vendor, model, …)” strings browsers send today.
                </p>
            }
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public ClientInfo Info { get; set; } = default!;

    private bool _loaded;
    private ClientHints? _hints;
    private string? _renderer;
    private GPU? _gpu;
    private int _touchPoints;
    private bool _iPadLike;

    private sealed record Row(string Label, string? FromUserAgent, string? FromHints, Verdict? Verdict);

    private sealed record Verdict(string Kind, string Text);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _hints = await Js.ClientHintsAsync();
        _renderer = await Js.WebGLRendererAsync();
        _gpu = _renderer is null ? null : UAParser.GetGPU(_renderer);
        _touchPoints = await Js.MaxTouchPointsAsync();
        _iPadLike = Info.OS.Name == "Mac OS" && _touchPoints > 1;
        _loaded = true;
        StateHasChanged();
    }

    private IEnumerable<Row> Rows(ClientHints hints)
    {
        var browsers = (hints.FullVersionList ?? hints.Brands).Where(b => !IsGrease(b.Brand)).ToList();
        var browser = browsers.FirstOrDefault(b => b.Brand != "Chromium") ?? browsers.FirstOrDefault();
        var fromHints = browser is null ? null : $"{browser.Brand} {browser.Version}";
        var uaBrowser = Words.Join(Info.Browser.Name, Info.Browser.Version);
        yield return new Row("Browser", uaBrowser, fromHints,
            Info.Browser.Version is { } v && v.EndsWith(".0.0.0") && hints.FullVersionList is not null
                ? new Verdict("more", "full version only in hints")
                : null);

        var system = SystemFromHints(hints);
        yield return new Row("Operating system", Words.OS(Info.OS), system, CompareSystems(hints, system));

        var model = hints.Model is null ? null : hints.Model.Length == 0 ? "(none)" : hints.Model;
        yield return new Row("Device model", Info.Device.Model, model,
            Info.Device.Model == "K" && !string.IsNullOrEmpty(hints.Model)
                ? new Verdict("differ", "“K” is a placeholder")
                : null);

        var architecture = hints.Architecture is { Length: > 0 } a
            ? Words.Join(a, hints.Bitness is { Length: > 0 } b ? $"({b}-bit)" : null)
            : null;
        yield return new Row("CPU", Info.CPU.Architecture, architecture, null);

        yield return new Row("Mobile", Words.DeviceKind(Info.Device.Type) ?? "no device type",
            (hints.Mobile ? "mobile" : "not mobile") + (hints.FormFactors is { Count: > 0 } f ? $" · {string.Join(", ", f)}" : ""),
            null);
    }

    // Brands such as "Not)A;Brand" are deliberately meaningless (GREASE).
    private static bool IsGrease(string brand) =>
        brand.Contains("Not", StringComparison.Ordinal) && brand.Contains("Brand", StringComparison.Ordinal);

    // Windows: platformVersion 13 or more is Windows 11, 1-10 is Windows 10, 0 is Windows 7, 8 or 8.1.
    // https://learn.microsoft.com/microsoft-edge/web-platform/how-to-detect-win11
    private static string? SystemFromHints(ClientHints hints)
    {
        if (string.IsNullOrEmpty(hints.Platform))
            return null;

        if (hints.PlatformVersion is not { Length: > 0 } version)
            return hints.Platform;

        if (hints.Platform == "Windows" && int.TryParse(version.Split('.')[0], out var major))
            return major >= 13 ? "Windows 11" : major > 0 ? "Windows 10" : "Windows 7, 8 or 8.1";

        return $"{hints.Platform} {version}";
    }

    private Verdict? CompareSystems(ClientHints hints, string? fromHints)
    {
        if (fromHints is null || Info.OS.Name is null)
            return null;

        var frozen = new Verdict("differ", "the user agent is frozen");
        if (hints.Platform == "Windows")
        {
            var same = fromHints == Words.OS(Info.OS)
                       || (fromHints.StartsWith("Windows 7,", StringComparison.Ordinal) && Info.OS.Version is "7" or "8" or "8.1");
            return same ? new Verdict("same", "same") : frozen;
        }

        // Elsewhere compare the versions: "15" in the user agent and "15.0.0" in the hints agree.
        if (Info.OS.Version is not { } fromUserAgent || hints.PlatformVersion is not { Length: > 0 } fromHint)
            return null;

        return fromHint == fromUserAgent || fromHint.StartsWith(fromUserAgent + ".", StringComparison.Ordinal)
               || fromUserAgent.StartsWith(fromHint + ".", StringComparison.Ordinal)
            ? new Verdict("same", "same")
            : frozen;
    }
}
