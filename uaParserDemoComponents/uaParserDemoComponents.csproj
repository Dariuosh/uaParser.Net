<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Pages, styles and scripts shared by the Blazor WebAssembly and Blazor Server demos. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\uaParserLibrary\uaParserLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Example user agents generated by tools/RuleGenerator -->
    <Compile Include="..\Shared\SampleUserAgents.g.cs" Link="Samples\SampleUserAgents.g.cs" />
  </ItemGroup>

</Project>
