@* Line icons drawn for the demos (24×24, stroked with the current text color). *@
<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@((MarkupString)Paths(Name))</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Class { get; set; }

    /// <summary>The icon for a device type; desktop when there is none.</summary>
    public static string ForDeviceType(string? type) => type switch
    {
        DeviceTypes.Mobile => "mobile",
        DeviceTypes.Tablet => "tablet",
        DeviceTypes.SmartTV => "tv",
        DeviceTypes.Console => "console",
        DeviceTypes.Wearable => "watch",
        DeviceTypes.Embedded => "box",
        _ => "desktop",
    };

