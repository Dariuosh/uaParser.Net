<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\uaParserLibrary\uaParserLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same user agents tools/RuleGenerator uses -->
    <None Include="..\tools\RuleGenerator\corpus\*.txt" Link="Corpus\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tools\RuleGenerator\corpus\ua-parser-js-1.0.41\*-test.json" Link="Corpus\ua-parser-js\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
