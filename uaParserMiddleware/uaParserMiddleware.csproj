<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>uaParser.Net.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for uaParser.Net: an injectable, per-request ClientInfo (with the request's User-Agent Client Hints), HttpContext.GetClientInfo(), an optional middleware that can ask for all client hints, and a shared cache for repeated user agents.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\uaParserLibrary\uaParserLibrary.csproj" />
  </ItemGroup>

</Project>
